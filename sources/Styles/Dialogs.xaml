<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="clr-namespace:Clio.Helpers"
                xmlns:conv="clr-namespace:Clio.Converters"
                xmlns:beh="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                xmlns:vm="clr-namespace:Clio.ViewModels">

    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

    <!-- Шаблон диалога удаления контакта -->
    <DataTemplate DataType="{x:Type vm:DeleteDialogViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="УДАЛЕНИЕ КОНТАКТА" 
                           Style="{StaticResource TitleLabelStyle}"/>
                
                <TextBlock Text="Вы уверены, что хотите безвозвратно удалить контакт?" 
                           Style="{StaticResource DefaultLabelStyle}"
                           LineHeight="20"/>
            </StackPanel>

            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,20,0,0">
                
                <Button Content="Отмена" 
                        Command="{Binding DataContext.ConfirmDeleteCommand, ElementName=RootWindow}" 
                        CommandParameter="No" 
                        Margin="0,0,12,0" 
                        Padding="20,10"/>

                <Button Content="Удалить" 
                        Command="{Binding DataContext.ConfirmDeleteCommand, ElementName=RootWindow}" 
                        CommandParameter="Yes" 
                        Padding="20,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#25FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#8B2E2E"/>
                                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Шаблон диалога ввода мастер-пароля -->
    <DataTemplate DataType="{x:Type vm:PasswordDialogViewModel}">
        <Grid>
            <StackPanel DataContext="{Binding DataContext, ElementName=RootWindow}">
                <!-- Заголовок и Описание -->
                <TextBlock x:Name="DialogTitle" 
                           Style="{StaticResource TitleLabelStyle}"
                           Text="Авторизация"/>
                
                <TextBlock x:Name="DialogDescription" 
                           Style="{StaticResource DefaultLabelStyle}"
                           Text="Введите мастер-пароль для расшифровки данных:"/>

                <!-- Поле ввода пароля -->
                <PasswordBox Style="{StaticResource PasswordBoxStyle}" 
                             Margin="0,0,0,20" 
                             Tag="{Binding PasswordHint}">
                    <beh:Interaction.Behaviors>
                        <h:PasswordBehavior Password="{Binding DataContext.MasterPassword, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                    </beh:Interaction.Behaviors>
                </PasswordBox>

                <!-- Поле ввода подсказки -->
                <StackPanel x:Name="HintInputPanel" 
                            Margin="0,0,0,20" 
                            Visibility="Collapsed">

                    <TextBox Text="{Binding PasswordHint, UpdateSourceTrigger=PropertyChanged}" 
                             Tag="Подсказка для пароля"/>
                </StackPanel>

                <!-- Кнопка -->
                <Button x:Name="ConfirmButton" 
                        Content="Авторизоваться" 
                        Command="{Binding UnlockDatabaseCommand}" 
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Триггер переключения режима при отсутствии БД -->
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsNewDatabase, ElementName=RootWindow}" Value="True">
                <Setter TargetName="DialogTitle" 
                        Property="Text" 
                        Value="СОЗДАНИЕ ХРАНИЛИЩА"/>
                
                <Setter TargetName="DialogDescription" 
                        Property="Text" 
                        Value="Придумайте надежный мастер-пароль и подсказку к нему. Все данные будут зашифрованы алгоритмом AES-256:"/>
                
                <Setter TargetName="HintInputPanel" 
                        Property="Visibility" 
                        Value="Visible"/>
                
                <Setter TargetName="ConfirmButton" 
                        Property="Content" 
                        Value="Создать"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
