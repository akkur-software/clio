<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FormRowStyle" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Tag" Value="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True, TargetNullValue=True}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <!-- Зона подписей -->
                            <ColumnDefinition Width="*"/>
                            <!-- Зона текстовых полей -->
                        </Grid.ColumnDefinitions>

                        <!-- Левая подпись -->
                        <ContentPresenter Grid.Column="0" Content="{TemplateBinding Header}" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultLabelStyle}">
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>

                        <!-- Правое поле ввода -->
                        <ContentPresenter Grid.Column="1" 
                                          Content="{TemplateBinding Content}" 
                                          VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>