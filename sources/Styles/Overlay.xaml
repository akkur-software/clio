<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ModalOverlayStyle" TargetType="ContentControl">
        <Setter Property="Panel.ZIndex" Value="99"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Background" Value="{DynamicResource ModalOverlayBackground}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- Сетка, перекрывающая весь экран приложения -->
                    <Grid Background="{TemplateBinding Background}">                      

                        <!-- 2. Центральное парящее матовое окошко диалога -->
                        <Border Width="440" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                CornerRadius="12" 
                                Background="#1AAAAAAA"
                                Padding="30,25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" 
                                                  Color="#000000" 
                                                  Opacity="0.5" 
                                                  Direction="270" 
                                                  ShadowDepth="5"/>
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="HasContent" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>