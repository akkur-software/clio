<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Стиль кнопок управления окном (Свернуть/Развернуть/Закрыть) -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#242C42"/>
            </Trigger>
        </Style.Triggers>
  </Style>

    <!-- Стиль кастомного заголовка -->
  <Style x:Key="TitleBarStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="#131A25"/>
    <Setter Property="Height" Value="50"/>
      
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}" 
                  Height="{TemplateBinding Height}">              
            <Grid Margin="15,0">

              <!-- Текст заголовка -->
              <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                         Style="{StaticResource TitleLabelStyle}" 
                         VerticalAlignment="Center"/>

              <!-- Системные команды -->
              <StackPanel HorizontalAlignment="Right" 
                          Orientation="Horizontal" 
                          VerticalAlignment="Center">
                  
                <Button Content="—" 
                        Margin="0,0,5,0" 
                        Command="{x:Static SystemCommands.MinimizeWindowCommand}" 
                        Style="{StaticResource TitleBarButtonStyle}"/>

                <Button Content="⬜" 
                        Margin="0,0,5,0" 
                        Command="{x:Static SystemCommands.MaximizeWindowCommand}" 
                        Style="{StaticResource TitleBarButtonStyle}"/>
                  
                <Button Content="✕" 
                        Command="{x:Static SystemCommands.CloseWindowCommand}" 
                        Style="{StaticResource TitleBarButtonStyle}"/>
              </StackPanel>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>