<Window x:Class="Clio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:h="clr-namespace:Clio.Helpers"
        xmlns:beh="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
        xmlns:local="clr-namespace:Clio"
        x:Name="RootWindow"
        Title="Clio" 
        Width="1300" 
        Height="700" 
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">
    
    <Grid x:Name="MainGrid">
        <Grid.Background>
            <ImageBrush x:Name="BackgroundBrush" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Контент -->
        </Grid.RowDefinitions>

        <!-- 1. ЗАГОЛОВОК ОКНА (Возвращаем ручной клик для перетаскивания) -->
        <ContentControl Grid.Row="0" Style="{StaticResource TitleBarStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

        <!-- 2. РАБОЧАЯ СЕТКА С ПАНЕЛЯМИ -->
        <Grid Grid.Row="1" MaxWidth="1500" HorizontalAlignment="Center" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая карточка (Список) -->
            <ContentControl Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Background="#0AFFFFFF" Width="400">
                <Grid Margin="15,15,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="SearchTextBox" 
                                 Grid.Column="0" 
                                 Tag="Найти контакт"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,10,0"/>

                        <Button Grid.Column="1" 
                                Content="+" 
                                Command="{Binding AddContactCommand}" 
                                Width="40" 
                                Height="40" 
                                Padding="0" 
                                FontSize="20"/>
                    </Grid>

                    <ListBox x:Name="ContactsListBox" 
                             Grid.Row="1" 
                             ItemTemplate="{StaticResource ContactTemplate}"
                             ItemsSource="{Binding ContactsView}"
                             SelectedItem="{Binding SelectedContact}"/>

                    <TextBlock Grid.Row="2" 
                               HorizontalAlignment="Left"
                               Style="{StaticResource PlaceholderLabelStyle}"
                               Foreground="#7A8A9E"
                               Text="{Binding ElementName=ContactsListBox, Path=Items.Count, StringFormat='Всего контактов: {0}'}"/>
                    
                </Grid>
            </ContentControl>

            <!-- Правая карточка (Детали) -->
            <ContentControl Grid.Column="1" 
                            Style="{StaticResource GlassPanelStyle}" 
                            x:Name="DetailsPanel" 
                            DataContext="{Binding SelectedContact}" 
                            MinWidth="400" 
                            MaxWidth="800">
                <Grid Margin="50,45">

                    <TextBlock Text="Выберите контакт для просмотра" 
                               Style="{StaticResource MutedLabelStyle}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.SelectedContact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}"/>

                    <!-- Основной контент карточки (виден, только если контакт выбран) -->
                    <StackPanel MaxWidth="550" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Top"
                                Visibility="{Binding DataContext.SelectedContact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted, FallbackValue=Collapsed}">

                        <HeaderedContentControl Header="ФАМИЛИЯ" Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="ИМЯ" Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="ОТЧЕСТВО" Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="РОЖДЕНИЕ" Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding BirthDate, UpdateSourceTrigger=LostFocus, Converter={StaticResource DateOnlyConverter}, TargetNullValue=''}" 
                                     Tag="ДД.ММ.ГГГГ">
                                <beh:Interaction.Behaviors>
                                    <h:MaskedDateBehavior />
                                </beh:Interaction.Behaviors>
                            </TextBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="ЗАМЕТКА" Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="ТЕЛЕФОН ОСН." Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}">
                                <beh:Interaction.Behaviors>
                                    <h:MaskedPhoneBehavior />
                                </beh:Interaction.Behaviors>
                            </TextBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="ТЕЛЕФОН ДОП." Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding PhoneAdvanced, UpdateSourceTrigger=PropertyChanged}">
                                <beh:Interaction.Behaviors>
                                    <h:MaskedPhoneBehavior />
                                </beh:Interaction.Behaviors>
                            </TextBox>
                        </HeaderedContentControl>                        

                        <HeaderedContentControl Header="EMAIL" Style="{StaticResource FormRowStyle}">
                            <TextBox x:Name="EmailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}">
                                <beh:Interaction.Behaviors>
                                    <h:MaskedEmailBehavior />
                                </beh:Interaction.Behaviors>
                            </TextBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="TELEGRAM ID" Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding TelegramId, UpdateSourceTrigger=PropertyChanged}"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="VK ID" Style="{StaticResource FormRowStyle}">
                            <TextBox Text="{Binding VkId, UpdateSourceTrigger=PropertyChanged}"/>
                        </HeaderedContentControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <!-- Кнопка "Удалить контакт" -->
                            <Button Content="Удалить контакт" 
                                    Command="{Binding DataContext.DeleteContactCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    Margin="0,0,15,0" 
                                    Padding="20,12"/>

                            <!-- Кнопка "Редактировать / Сохранить" -->
                            <Button Content="{Binding DataContext.EditSaveButtonText, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    Command="{Binding DataContext.ToggleEditSaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>

        <Grid Grid.RowSpan="2" Panel.ZIndex="9999">
            <!-- Стороны -->
            <Border Height="5" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeSide_MouseLeftButtonDown"/>
            <Border Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeSide_MouseLeftButtonDown"/>
            <Border Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeSide_MouseLeftButtonDown"/>
            <Border Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeSide_MouseLeftButtonDown"/>

            <!-- Углы -->
            <Border Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeSide_MouseLeftButtonDown"/>
            <Border Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeSide_MouseLeftButtonDown"/>
            <Border Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeSide_MouseLeftButtonDown"/>
            <Border Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeSide_MouseLeftButtonDown"/>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding ActiveDialog}" Style="{StaticResource ModalOverlayStyle}"/>

    </Grid>
</Window>
    